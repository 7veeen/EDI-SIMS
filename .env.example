# ====================================================================
# SMART INVENTORY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ====================================================================

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=smart-inventory-secret-key-change-in-production

# Supabase PostgreSQL Configuration
# Retrieve these credentials from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here
# Optional Direct PostgreSQL Connection String:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres
